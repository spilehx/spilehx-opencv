<xml>

    <!-- Build the static OpenCV CFFI wrapper -->
    <!-- Use package-haxelib.sh to supply OpenCV paths and GStreamer compiler flags. -->

    <include name="${HXCPP}/build-tool/BuildCommon.xml"/>

    <section if="PATH_TO_TEMP_DIR">
        <set name="OPENCV_BASE_TOOLCHAIN" value="${toolchain}"/>
        <set name="toolchain" value="opencv"/>
    </section>

    <!-- Headers can be supplied with -DOPENCV_INCLUDE_DIR=... -->
    <set name="OPENCV_INCLUDE_DIR" value="/usr/local/include/opencv5" unless="OPENCV_INCLUDE_DIR"/>

    <!-- Determine the output location for the wrapper archive -->

    <set name="PATH_TO_VENDOR_NDLL_DIR" value="ndll" unless="PATH_TO_VENDOR_NDLL_DIR"/>

    <section if="linux">
        <set name="LIB_SUFFIX" value="Linux" unless="HXCPP_M64"/>
        <set name="LIB_SUFFIX" value="Linux64" if="HXCPP_M64"/>
    </section>

    <!-- Specify the list of files to be compiled and the compile options. -->

    <files id="common">
        <compilerflag value="-Icpp"/>
        <compilerflag value="-DSTATIC_LINK"/>
        <compilerflag value="-I${OPENCV_INCLUDE_DIR}"/>
        <compilerflag value="-std=c++17"/>

        <file name="cpp/main.cpp"/>
        <file name="cpp/core.cpp"/>
        <file name="cpp/imgproc.cpp"/>
        <file name="cpp/imgcodecs.cpp"/>
        <file name="cpp/features2d.cpp"/>
        <file name="cpp/objdetect.cpp"/>
        <file name="cpp/video.cpp"/>
        <file name="cpp/videoio.cpp"/>
        <file name="cpp/highgui.cpp"/>
        <file name="cpp/videoencoder.cpp"/>
    </files>

    <!-- Generated from pkg-config by build_vendor.sh. -->
    <include name="${GSTREAMER_BUILD_XML}" if="GSTREAMER_BUILD_XML"/>

    <!-- Generate the wrapper archive; OpenCV is linked by the consuming application. -->

    <set name="configuration_type" value="static_link"/>

    <target id="opencv" output="opencv" tool="linker" toolid="${configuration_type}">
        <outdir name="${PATH_TO_VENDOR_NDLL_DIR}/${LIB_SUFFIX}"/>
        <ext value=".a"/>

        <files id="common"/>

    </target>

    <target id="default">
        <target id="opencv"/>
    </target>
</xml>
